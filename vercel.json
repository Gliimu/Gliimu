{
  "rewrites": [
    { "source": "/auth", "destination": "/auth.html" },
    { "source": "/dashboard/:path*", "destination": "/dashboard/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*).(css|js)",
      "headers": [
        { "key": "Content-Type", "value": "text/$1" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
