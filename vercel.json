{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "dashboard.gliimu.com" }], "destination": "/xplore" },
    { "source": "/index.html", "has": [{ "type": "host", "value": "dashboard.gliimu.com" }], "destination": "/xplore" }
  ],
  "rewrites": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "dashboard.gliimu.com" }], "destination": "/dashboard/index.html" }
  ],
  "headers": [
    {
      "source": "/dashboard/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/shared/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/icons/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
